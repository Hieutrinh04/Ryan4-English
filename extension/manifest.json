{
  "manifest_version": 3,
  "name": "Lexilo — Lấy bài từ YouTube",
  "version": "0.2.4",
  "description": "Lấy phụ đề của video YouTube đang xem và tạo bài nghe chép chính tả, nói nhại trong Lexilo.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Gửi video này sang Lexilo",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
