# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...trừ file mẫu: nó chỉ có tên biến và giá trị giả, cần theo dự án.
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# dev server logs & build artifacts
.dev-server.*.log
/.lexilo-dev.*.log
tsconfig.tsbuildinfo
*.tar.gz

# scratch dirs
/tmp/
/.tmp_xlsx/

# thư mục tạm & phụ thuộc của script
/.tmp/
scripts/node_modules/

# cấu hình công cụ dev cục bộ, không đưa lên repo
/.claude/
/.openai/

# log của script khởi động lại dev server
/.lexilo-restart.*.log

# bản sao lưu tay khi sửa CSS lớn — chỉ có nghĩa trên máy đang sửa
*.css.bak

# trạng thái cục bộ của Supabase CLI (project-ref, pooler-url…)
/supabase/.temp/
