NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Tài khoản chủ sở hữu được thấy bộ từ cá nhân cũ (Thứ Hai–Chủ Nhật + PDF).
# Nếu bỏ trống, ứng dụng dùng ADMIN_EMAILS / ADMIN_USER_IDS làm dự phòng.
ADMIN_EMAILS=
ADMIN_USER_IDS=
LEGACY_LIBRARY_EMAILS=
LEGACY_LIBRARY_USER_IDS=

# Khoá mô hình ngôn ngữ. Chỉ dùng ở server — KHÔNG đặt tiền tố NEXT_PUBLIC_.
# Có OPENROUTER_API_KEY thì nó được ưu tiên hơn GEMINI_API_KEY.
GEMINI_API_KEY=your-server-only-gemini-key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# RAG dùng Gemini Embeddings 768 chiều. Mặc định dùng chung GEMINI_API_KEY;
# chỉ đặt RAG_EMBEDDING_API_KEY khi muốn tách quota sang một khoá khác.
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_MATCH_THRESHOLD=0.42

# Hạn mức gọi route AI. Bỏ trống là dùng mặc định trong lib/ai-guard.ts.
# Khách vãng lai chỉ nhận diện được bằng IP nên bị khoá chặt hơn nhiều.
AI_GUEST_BURST=4
AI_GUEST_DAILY=40
AI_MEMBER_BURST=12
AI_MEMBER_DAILY=400

# YouTube Data API v3 — lấy tiêu đề, kênh, thời lượng, ảnh bìa của video.
# Chỉ dùng ở server, KHÔNG đặt tiền tố NEXT_PUBLIC_.
# Lưu ý: khoá API KHÔNG tải được phụ đề (captions.download đòi OAuth của chủ kênh).
YOUTUBE_API_KEY=

# Khoá service role của Supabase. Dùng cho những việc phải ghi vượt RLS: xác nhận
# đơn thanh toán, cấp/gỡ Premium, và nhận góp ý của người dùng.
# TUYỆT ĐỐI chỉ ở server — lộ ra là mất toàn quyền cơ sở dữ liệu.
SUPABASE_SERVICE_ROLE_KEY=

# Thanh toán chuyển khoản: thông tin tài khoản nhận và khoá webhook ngân hàng
# (SePay/Casso) để tự xác nhận đơn.
BANK_CODE=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_WEBHOOK_KEY=
